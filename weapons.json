        "gravityAnomalyDuration": 3.0,
        "gravityAnomalyStrength": -0.6
      },

      "visual": {
        "trailColor": "#00d4d4",
        "trailLength": 22,
        "impactEffect": "anti_grav_field",
        "soundEffect": "anti_grav_barrage",
        "antigravDistortion": true,
        "floatingDebris": true
      }
    }
