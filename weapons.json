  "weaponSets": {
    "starter": {
      "name": "Starter Set",
      "description": "Basic weapons available from the start",
      "weapons": ["rail_shot", "plasma_arc"]
    },
    "advanced": {
      "name": "Advanced Set",
      "description": "Unlocked after level 1",
      "weapons": ["rail_shot", "plasma_arc", "cluster_swarm", "vector_seeker"]
    },
    "elite": {
      "name": "Elite Set",
      "description": "Unlocked after level 2",
      "weapons": ["rail_shot", "plasma_arc", "cluster_swarm", "vector_seeker", "orbital_beacon", "emp_pulse", "gravitic_missile"]
    },
    "ultimate": {
      "name": "Ultimate Set",
      "description": "All weapons unlocked",
      "weapons": ["rail_shot", "plasma_arc", "cluster_swarm", "vector_seeker", "orbital_beacon", "emp_pulse", "quantum_bomb", "phase_disruptor", "gravitic_missile", "anti_grav_barrage"]
    }
  },

  "balancingNotes": {
    "energyEconomy": "All weapons draw from shared 100-energy pool. Regeneration = 20 per turn (base).",
    "heatManagement": "Heat reduces energy regen. Overheat (>100 heat) disables systems for 1 turn.",
    "cooldownStrategy": "Cooldowns prevent rapid-fire of powerful weapons. Plan multi-turn strategies.",
    "tierProgression": "Tier 1 = basic, Tier 2 = tactical, Tier 3 = game-changing",
    "exoticWeapons": "Require multi-round charging. High risk, high reward.",
    "graviticWeapons": "Unique terrain/movement manipulation. Zone control focus."
  }
}
