      "projectile": {
        "velocity": 110,
        "mass": 3.0,
        "radius": 0.18,
        "dragCoefficient": 0.15,
        "windResistance": 0.4,
        "maxSpeed": 140,
        "phaseMode": true
      },

      "behavior": {
        "type": "phase",
        "phaseFrequency": 2.0,
        "phaseDuration": 0.3,
        "ignoresTerrainCollision": false,
        "ignoresTankCollision": true
      },

      "terrain": {
        "deformationType": "precise_hole",
        "deformationStrength": 3.0,
        "affectsGravity": false
      },

      "visual": {
        "trailColor": "#00ffff",
        "trailLength": 35,
        "impactEffect": "phase_breach",
        "soundEffect": "phase_disruptor",
        "phaseShimmer": true,
        "warpEffect": true
      }
    },

    "gravitic_missile": {
      "id": "gravitic_missile",
      "name": "Gravitic Missile",
      "category": "gravitic",
      "tier": 3,
      "description": "Manipulates local gravity field, pulling enemies and terrain toward impact point.",
      "unlockLevel": 2,

      "energyCost": 45,
      "heatGeneration": 18,
      "cooldownTurns": 3,

      "damage": {
        "direct": 35,
        "explosionRadius": 25,
        "falloffType": "linear",
        "armorPiercing": 0.1,
        "graviticPull": true
      },

      "projectile": {
        "velocity": 85,
        "mass": 6.0,
        "radius": 0.25,
        "dragCoefficient": 0.3,
        "windResistance": 0.7,
        "maxSpeed": 105
      },

      "behavior": {
        "type": "gravitic",
        "pullRadius": 40,
        "pullStrength": 10.0,
        "pullDuration": 2.0,
        "affectsTanks": true,
        "affectsTerrain": true
      },

      "terrain": {
        "deformationType": "pull_crater",
        "deformationStrength": 10.0,
        "affectsGravity": true,
        "gravityAnomalyDuration": 3.0,
        "gravityAnomalyStrength": 0.5
      },

      "visual": {
        "trailColor": "#1abc9c",
        "trailLength": 25,
        "impactEffect": "gravity_well",
        "soundEffect": "gravitic_missile",
        "gravityDistortion": true,
        "pullVisual": "gravity_lines"
      }
    },

    "anti_grav_barrage": {
      "id": "anti_grav_barrage",
      "name": "Anti-Grav Barrage",
      "category": "gravitic",
      "tier": 3,
      "description": "Creates anti-gravity zone that launches enemies upward and disrupts movement.",
      "unlockLevel": 3,

      "energyCost": 40,
      "heatGeneration": 16,
      "cooldownTurns": 3,

      "damage": {
        "direct": 25,
        "explosionRadius": 30,
