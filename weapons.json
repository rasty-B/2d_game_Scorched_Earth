      },

      "projectile": {
        "velocity": 95,
        "mass": 5.0,
        "radius": 0.22,
        "dragCoefficient": 0.25,
        "windResistance": 0.9,
        "maxSpeed": 115
      },

      "behavior": {
        "type": "anti_gravitic",
        "fieldRadius": 35,
        "fieldDuration": 2.5,
        "launchDirection": "upward",
